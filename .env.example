# Set these server-side in the existing Vercel project. Never expose them with VITE_.
POSTGRES_URL=postgresql://user:password@host:5432/database
JWT_SECRET=
# Preserve the current production key to keep existing passwords readable.
ENCRYPTION_KEY=
TOKEN_TIME=1h
WEBAUTHN_INVITE_CODE=
APP_ORIGIN=https://passbook-db.vercel.app
# Optional PEM CA for a database using a private certificate authority.
POSTGRES_CA=
